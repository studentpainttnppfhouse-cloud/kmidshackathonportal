{
  "name": "hackathon-studio",
  "version": "1.0.0",
  "private": true,
  "description": "KMIDS Hackathon 2027 Staff Portal",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "tsx scripts/db-bootstrap.ts || true",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prisma.ts migrate dev",
    "db:deploy": "tsx scripts/prisma.ts migrate deploy",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "tsx scripts/prisma.ts studio",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "playwright test tests/e2e",
    "audit": "npm audit --audit-level=high --omit=dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bcryptjs": "2.4.3",
    "docx-preview": "^0.3.6",
    "jszip": "^3.10.1",
    "next": "^16.4.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "read-excel-file": "^5.8.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prisma": "6.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
