# ---------------------------------------------------------------------------
# What the portal reads. Only DATABASE_URL is required; OWNER_EMAIL is how the
# first account gets created.
# ---------------------------------------------------------------------------

# TiDB Cloud Serverless. Port is 4000 (not 3306) and TLS is mandatory —
# without it TiDB answers "1105: Connections using insecure transport are
# prohibited". Keep ?sslaccept=strict on the end; if it is missing from a
# tidbcloud.com URL the portal appends it (see src/lib/database-url.ts).
# Copy this from the TiDB Cloud console:
#   Cluster -> Connect -> Connect With -> Prisma
DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.REGION.prod.aws.tidbcloud.com:4000/hackathon_studio?sslaccept=strict"

# Generate once with:  openssl rand -base64 32
# Used for CSRF tokens and cookie integrity. Sessions do NOT depend on it, so
# rotating this will not sign anybody out.
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# The first account. Set it before the first deploy: when the database is empty
# the bootstrap seeds a T4 owner invite and prints the link — in the Render
# deploy log if you are on the free plan, which has no Shell. Safe to remove
# once somebody has signed in.
OWNER_EMAIL="you@kmids.ac.th"

# Optional. Sign-in is limited to @kmids.ac.th unless this says otherwise —
# useful only if the school addresses are not handed out yet.
# ALLOWED_EMAIL_DOMAIN="kmids.ac.th"

# Optional, and worth setting. The portal's public URL, used wherever a link
# has to leave the app and come back — a QR code on a poster carries no
# referrer, so "/join/abc" printed on paper is useless. Without it the portal
# reads the forwarded Host header, which is right on Render and wrong behind a
# custom domain that rewrites it.
# APP_URL="https://hackathon-studio.onrender.com"

# Optional. How large a file may be uploaded into the database, in megabytes.
# Default 10, hard-capped at 20 by the Server Action body limit in
# next.config.ts. Anything over it is recorded as a link to Drive instead, so
# raising this is about convenience, not capability — and every megabyte here
# is a megabyte of the TiDB free tier's 5 GiB.
# MAX_UPLOAD_MB="10"

# ---------------------------------------------------------------------------
# Microsoft Teams notifications. All optional — with none of this set, the
# notification page loads, explains what is missing, and queues nothing.
# Full setup guide: docs/TEAMS.md
# ---------------------------------------------------------------------------

# Required before anything actually sends. The queue is drained by
# /api/teams/dispatch, which is an HTTP endpoint because Render's free plan has
# no cron — so a shared secret is the whole of its security. Under 16
# characters counts as unset. Generate with: openssl rand -base64 32
# TEAMS_DISPATCH_SECRET="replace-me-with-openssl-rand-base64-32"

# Extra hosts the portal may POST a webhook to, comma-separated. Only needed on
# a sovereign cloud. webhook.office.com and logic.azure.com are always allowed;
# this adds to that list and cannot replace it.
# TEAMS_WEBHOOK_HOSTS="logic.azure.us"

# Optional, and only for notifying one person rather than a channel. Needs a
# Microsoft 365 tenant admin to register an app and consent to the
# TeamsActivity.Send application permission. Channel posts need none of this.
# MS_TENANT_ID=""
# MS_CLIENT_ID=""
# MS_CLIENT_SECRET=""
# MS_TEAMS_APP_ID=""

# Optional. Password reset by email, sent through Resend (resend.com). Verify
# kmidshackportal.com in Resend and add its DNS records in Cloudflare first.
# Without the key, "forgot password" goes to the admins as before.
# RESEND_API_KEY="re_..."
# MAIL_FROM="KMIDS Hack Portal <no-reply@kmidshackportal.com>"
