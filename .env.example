# ---------------------------------------------------------------------------
# The database.
#
# One PostgreSQL connection URI, in full. Anything that speaks Postgres works:
# an RDS or Aurora endpoint, a Render PostgreSQL instance, or a database on
# your own machine.
#
#   postgresql://user:password@host:5432/dbname
#
# A password containing punctuation has to be URL-encoded (@ becomes %40).
# TLS is decided from the host: required for anything remote, off for
# localhost. Add ?sslmode=disable only for a host that terminates TLS itself.
#
# Also read from POSTGRES_URL, POSTGRESQL_URL, RDS_DATABASE_URL and
# PG_CONNECTION_STRING, so a value injected under one of those names works
# without being copied.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://portal:password@localhost:5432/hackathon_studio

# ---------------------------------------------------------------------------
# Owner bootstrap — two Owners always exist (see §4 of the brief) so that one
# graduating student is never a single point of failure.
# ---------------------------------------------------------------------------
OWNER_EMAIL=owner@kmids.ac.th
OWNER_BACKUP_EMAIL=backup-owner@kmids.ac.th

# Anyone with an address at this domain may sign in. Everyone else needs an
# explicit invite from the Owner.
SCHOOL_EMAIL_DOMAIN=kmids.ac.th

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------
# Connections held per instance. The default of 8 suits one Render web service
# against a small RDS instance; lower it if the server runs out of slots.
# DATABASE_POOL_MAX=8

# The CA used to verify the database's certificate. Defaults to the AWS RDS
# bundle committed at certs/rds-global-bundle.pem. Set this only for a provider
# that uses its own root.
# RDS_CA_CERT=
