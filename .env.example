# ---------------------------------------------------------------------------
# Supabase — from your project's dashboard, Settings > API
#
# If you added Supabase through the Vercel Marketplace, `vercel env pull` gives
# you these under its own names and the app reads those too:
#   NEXT_PUBLIC_SUPABASE_URL       <- SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  <- SUPABASE_ANON_KEY / *_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY      <- SUPABASE_SECRET_KEY
#   SUPABASE_DB_URL                <- POSTGRES_URL_NON_POOLING (setup script)
# SUPABASE_JWT_SECRET is the exception — copy that one across by hand.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Never expose this to the browser: it bypasses every RLS
# policy. It is used to provision accounts and to apply Owner decisions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings > API > JWT Settings > JWT Secret.
# Sign-in is email-only, so the app mints its own PostgREST token with this
# secret. Every RLS policy still applies to that token.
SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-characters

# ---------------------------------------------------------------------------
# Owner bootstrap — two Owners always exist (see §4 of the brief) so that one
# graduating student is never a single point of failure.
# ---------------------------------------------------------------------------
OWNER_EMAIL=owner@kmids.ac.th
OWNER_BACKUP_EMAIL=backup-owner@kmids.ac.th

# Anyone with an address at this domain may sign in. Everyone else needs an
# explicit invite from the Owner.
SCHOOL_EMAIL_DOMAIN=kmids.ac.th

# ---------------------------------------------------------------------------
# Aurora PostgreSQL on AWS  (optional — the portal still runs on Supabase)
#
# `vercel env pull` writes most of these for you once the project is linked and
# the AWS integration is installed. Only fill them in by hand if you are
# connecting from a laptop.
#
# The app reads several names for each value, because the AWS and Postgres
# integrations each inject their own — see src/lib/aws/config.ts.
# ---------------------------------------------------------------------------
RDS_HOSTNAME=your-cluster.cluster-abc123.ap-southeast-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=hackathon
RDS_USERNAME=portal
AWS_REGION=ap-southeast-1

# Set by the Vercel AWS integration. With it, the deployment exchanges its OIDC
# token for this IAM role and signs a 15-minute database token — so there is no
# database password stored anywhere. Leave it unset locally.
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/vercel-hackathon-studio

# Only for a laptop, or a host without OIDC. Ignored when AWS_ROLE_ARN is set.
# RDS_PASSWORD=

# Or give the whole thing as one URI instead of the five values above.
# AURORA_DATABASE_URL=postgresql://portal@your-cluster.rds.amazonaws.com:5432/hackathon
