// KMIDS Hackathon 2027 — Staff Portal ("Hackathon Studio")
// Target: TiDB Cloud Serverless (MySQL protocol, port 4000, TLS required).
//
// relationMode = "prisma" because TiDB does not enforce foreign keys the way
// MySQL does in every configuration. Referential integrity is enforced by the
// application, not the database. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Permission tiers are cumulative: each tier includes everything below it.
enum Tier {
  T0_ADVISOR
  T1_MEMBER
  T2_HEAD
  T3_ADMIN
  T4_OWNER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String? @db.VarChar(255)
  /// Optional short sign-in name, an alternative to the email at login.
  username     String? @unique @db.VarChar(64)

  name      String
  nickname  String?
  grade     String?
  phone     String?
  lineId    String?
  avatarUrl String? @db.Text
  shirtSize String?
  roleTitle String?

  tier         Tier    @default(T1_MEMBER)
  departmentId String?

  /// Set when the account was created by scanning or opening a join link.
  joinedViaLinkId String?

  isReserve Boolean @default(false)
  isMentor  Boolean @default(false)
  isAlumni  Boolean @default(false)
  isActive  Boolean @default(true)

  // Login throttling — 5 failures locks the account for 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  profileCompletedAt DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  headOf            Department[]         @relation("DepartmentHead")
  sessions          Session[]
  passwordResets    PasswordReset[]
  invitesSent       Invite[]             @relation("InviteInvitedBy")
  inviteLinks       InviteLink[]         @relation("InviteLinkCreatedBy")
  joinedVia         InviteLink?          @relation("InviteLinkJoiners", fields: [joinedViaLinkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments       Attachment[]
  assignmentsMade   Assignment[]         @relation("AssignmentCreatedBy")
  assignmentsOwned  AssignmentAssignee[]
  comments          Comment[]
  documents         Document[]
  files             FileAsset[]
  forms             Form[]
  formResponses     FormResponse[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  checkins          Checkin[]
  incidents         Incident[]
  auditEntries      AuditLog[]
  teamsIdentity     TeamsIdentity?
  notificationsGot  NotificationJob[]    @relation("NotificationRecipient")
  notificationsSent NotificationJob[]    @relation("NotificationCreatedBy")
  passkeys          Passkey[]
  portalNotices     PortalNotice[]

  @@index([departmentId])
  @@index([tier])
  @@index([joinedViaLinkId])
  @@map("users")
}

/// Opaque, database-backed sessions.
///
/// The cookie carries a random 32-byte token; only its SHA-256 hash is stored.
/// Nothing about the session depends on an application secret, so a redeploy —
/// or even a rotated AUTH_SECRET — cannot log anybody out. This is what makes
/// "sign in once" true across updates.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userAgent  String?   @db.Text
  ip         String?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invite {
  id           String    @id @default(cuid())
  email        String
  code         String    @unique @db.VarChar(64)
  tier         Tier      @default(T1_MEMBER)
  departmentId String?
  name         String?
  roleTitle    String?
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  invitedBy  User        @relation("InviteInvitedBy", fields: [invitedById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([email])
  @@index([invitedById])
  @@index([departmentId])
  @@map("invites")
}

/// Admin-issued only. No email service is part of this deployment: T4 generates
/// the link in the admin panel and hands it to the person directly.
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  code       String    @unique @db.VarChar(64)
  issuedById String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Structure
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  color       String  @default("#EC4899")
  icon        String?
  headUserId  String?
  sortOrder   Int     @default(0)
  isGeneral   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  head          User?          @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members       User[]         @relation("DepartmentMembers")
  invites       Invite[]
  inviteLinks   InviteLink[]
  attachments   Attachment[]
  assignments   Assignment[]
  documents     Document[]
  files         FileAsset[]
  forms         Form[]
  announcements Announcement[]

  teamsTargets      TeamsTarget[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([headUserId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// Assignments — the core module
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_REVIEW
  APPROVED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Assignment {
  id           String           @id @default(cuid())
  title        String
  description  String?          @db.Text
  departmentId String
  createdById  String
  dueDate      DateTime?
  priority     Priority         @default(MEDIUM)
  status       AssignmentStatus @default(NOT_STARTED)
  approvedById String?
  approvedAt   DateTime?
  linkUrl      String?          @db.Text
  recurrence   String?
  year         Int              @default(2027)
  sortOrder    Int              @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department           @relation(fields: [departmentId], references: [id])
  createdBy  User                 @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  assignees  AssignmentAssignee[]

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([year])
  @@map("assignments")
}

model AssignmentAssignee {
  assignmentId String
  userId       String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@id([assignmentId, userId])
  @@index([userId])
  @@map("assignment_assignees")
}

/// Polymorphic by design: comments hang off assignments, documents, incidents.
/// TiDB has no cross-table FK enforcement anyway, so a discriminator column is
/// no weaker here than a real relation would be.
model Comment {
  id         String    @id @default(cuid())
  parentType String    @db.VarChar(32)
  parentId   String
  userId     String
  body       String    @db.Text
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([parentType, parentId])
  @@index([userId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

enum DocStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

/// A document is either a link to something in Google Drive, or a document
/// written in the portal itself. `source` says which, and exactly one of
/// `externalUrl` / `body` is meaningful for a given row.
model Document {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  departmentId String
  ownerId      String
  /// Set for source = "external". Null for documents written in the portal.
  externalUrl  String?   @db.Text
  /// "external" (a Drive link) or "portal" (written here, body below).
  source       String    @default("external") @db.VarChar(16)
  /// Markdown body for source = "portal". Never rendered as raw HTML.
  body         String?   @db.LongText
  /// Optional attachment to a task, so a submission is the document itself.
  assignmentId String?
  status       DocStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  tags         Json?
  year         Int       @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  owner      User       @relation(fields: [ownerId], references: [id])

  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
  @@index([year])
  @@index([assignmentId])
  @@map("documents")
}

model FileAsset {
  id           String  @id @default(cuid())
  name         String
  description  String? @db.Text
  /// Set for kind = "link". Null for an asset uploaded into the portal, whose
  /// bytes are an Attachment with parentType = "file" and parentId = this id.
  externalUrl  String? @db.Text
  kind         String  @default("link")
  departmentId String
  uploadedById String
  tags         Json?
  isBrandKit   Boolean @default(false)
  year         Int     @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  @@index([departmentId])
  @@index([uploadedById])
  @@index([isBrandKit])
  @@map("files")
}

model Form {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  type          String    @default("external")
  url           String?   @db.Text
  slug          String?   @unique
  schema        Json?
  ownerId       String
  departmentId  String?
  deadline      DateTime?
  responseCount Int       @default(0)
  responseUrl   String?   @db.Text
  isOpen        Boolean   @default(true)
  year          Int       @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner      User           @relation(fields: [ownerId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  responses  FormResponse[]

  @@index([ownerId])
  @@index([departmentId])
  @@map("forms")
}

model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  userId      String?
  /// The address the respondent gave (or the signed-in member's own).
  respondentEmail String? @db.VarChar(254)
  payload     Json
  submittedAt DateTime @default(now())

  form Form  @relation(fields: [formId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([formId])
  @@index([userId])
  @@index([formId, respondentEmail])
  @@map("form_responses")
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

model Announcement {
  id           String  @id @default(cuid())
  title        String
  body         String  @db.Text
  scope        String  @default("all")
  departmentId String?
  authorId     String
  pinned       Boolean @default(false)
  year         Int     @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author     User               @relation(fields: [authorId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  reads      AnnouncementRead[]

  @@index([authorId])
  @@index([departmentId])
  @@index([pinned])
  @@map("announcements")
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ---------------------------------------------------------------------------
// Event day
// ---------------------------------------------------------------------------

model EventItem {
  id        String  @id @default(cuid())
  day       String
  startTime String
  endTime   String?
  title     String
  location  String?
  notes     String? @db.Text
  ownerId   String?
  sortOrder Int     @default(0)
  year      Int     @default(2027)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
  @@index([year])
  @@map("event_items")
}

model Checkin {
  id           String    @id @default(cuid())
  userId       String
  day          String
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([day])
  @@map("checkins")
}

model Incident {
  id           String    @id @default(cuid())
  reportedById String
  occurredAt   DateTime  @default(now())
  severity     String    @default("low")
  description  String    @db.Text
  location     String?
  resolution   String?   @db.Text
  resolvedAt   DateTime?
  year         Int       @default(2027)

  reportedBy User @relation(fields: [reportedById], references: [id])

  @@index([reportedById])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(64)
  targetType String?  @db.VarChar(32)
  targetId   String?
  detail     String?  @db.Text
  /// success | failed | denied
  result     String   @default("success") @db.VarChar(16)
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([result])
  @@index([createdAt])
  @@map("audit_log")
}

/// The brand kit, as data rather than a hard-coded array.
///
/// Colours and fonts were a constant in the source, which meant every tweak was
/// a redeploy and nobody outside the repository could make one. They live here
/// so a T3 can add the twentieth shade of pink from the portal itself, and so
/// the Brand Kit export has something real to read.
model BrandToken {
  id          String   @id @default(cuid())
  /// "color" or "font".
  kind        String   @default("color") @db.VarChar(16)
  name        String
  /// A #RRGGBB hex for a colour; a CSS font stack for a font.
  value       String   @db.Text
  /// Free-text grouping — "Primary", "Neutrals", "Headings".
  groupName   String?  @db.VarChar(60)
  note        String?  @db.Text
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([sortOrder])
  @@map("brand_tokens")
}

/// Single-row key/value table for portal-wide switches (archive mode,
/// event-day mode, the countdown target).
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Join links — the organisation invite, the way Teams does it
// ---------------------------------------------------------------------------

/// One link the whole team can use, instead of one invite per person.
///
/// The per-email `Invite` above still exists and is still the precise tool: it
/// names one address and burns itself on first use. A join link is the other
/// half — the thing you print on a poster, paste in the LINE group, or put on
/// a slide at the first staff meeting so sixty people register themselves in
/// the five minutes you have their attention.
///
/// What keeps it from being an open sign-up page:
///
///   - the email domain is still enforced, so only @kmids.ac.th can register;
///   - the tier it grants is capped (see JOIN_LINK_MAX_TIER) — a self-serve
///     link can never mint an admin, whoever gets hold of it;
///   - uses, expiry and revocation are all first-class, so a leaked link is a
///     link you switch off;
///   - `users.joinedViaLinkId` records which link an account came through, so
///     a bad one can be traced after the fact rather than guessed at.
model InviteLink {
  id    String @id @default(cuid())
  code  String @unique @db.VarChar(64)
  /// What the link is for, in the admin list: "Staff meeting poster", "LINE".
  label String

  tier         Tier    @default(T1_MEMBER)
  departmentId String?
  roleTitle    String?

  createdById String
  /// Null means unlimited. A number is a hard ceiling, checked on every use.
  maxUses     Int?
  useCount    Int    @default(0)

  /// Null means it never expires on its own.
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy  User        @relation("InviteLinkCreatedBy", fields: [createdById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  joiners    User[]      @relation("InviteLinkJoiners")

  @@index([createdById])
  @@index([departmentId])
  @@map("invite_links")
}

// ---------------------------------------------------------------------------
// Attachments — files, in the database, revising decision D2-1
// ---------------------------------------------------------------------------

/// A file somebody attached, wherever they attached it.
///
/// The original design stored links only, because Render wipes its disk on
/// every deploy and "upload" therefore meant "lose it next Tuesday". That
/// reasoning was about the *disk*. The database is not the disk: TiDB survives
/// every redeploy the disk does not, so the bytes go there instead, in
/// `attachment_chunks`, and a file attached from a phone at the back of a
/// classroom is still there after the next deploy.
///
/// Two storage modes, chosen by size rather than by the person uploading:
///
///   "db"   — the bytes are in attachment_chunks. Anything up to the limit in
///            src/lib/attachments.ts.
///   "link" — over the limit. The row keeps the name and the URL of wherever
///            the file actually lives, so a 400MB export video is still
///            findable from the task it belongs to.
///
/// `parentType` + `parentId` are polymorphic for the same reason `comments`
/// are: TiDB enforces no foreign keys here anyway, so a discriminator column
/// costs nothing a real relation would have given us. Permission is never
/// stored on the attachment — it is always re-derived from the parent, so a
/// task that moves department takes its files with it.
model Attachment {
  id         String @id @default(cuid())
  parentType String @db.VarChar(32)
  parentId   String

  name     String @db.VarChar(255)
  /// Sanitised on the way in; see safeMimeType(). Never trusted from the browser.
  mimeType String @db.VarChar(120)
  size     Int
  /// SHA-256 of the bytes. Lets a re-upload be spotted, and a download verified.
  checksum String @default("") @db.VarChar(64)

  /// "db" or "link".
  storage     String  @default("db") @db.VarChar(8)
  externalUrl String? @db.Text

  /// Copied from the parent at upload time, for the department filter only.
  departmentId String?
  uploadedById String

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  uploadedBy User              @relation(fields: [uploadedById], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])
  chunks     AttachmentChunk[]

  @@index([parentType, parentId])
  @@index([uploadedById])
  @@index([departmentId])
  @@map("attachments")
}

/// The bytes, split up.
///
/// One row per 256 KB. TiDB caps the size of a single transaction entry, and a
/// 10 MB LONGBLOB in one row is a row every `SELECT *` on the table has to drag
/// through the network — so the file is written in pieces and streamed back the
/// same way, one chunk in memory at a time rather than the whole thing.
model AttachmentChunk {
  id           String @id @default(cuid())
  attachmentId String
  idx          Int
  bytes        Bytes  @db.MediumBlob

  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@unique([attachmentId, idx])
  @@map("attachment_chunks")
}

// ---------------------------------------------------------------------------
// Microsoft Teams — telling people, where they already are
// ---------------------------------------------------------------------------

/// What made the portal want to say something.
enum NotificationKind {
  MANUAL
  ANNOUNCEMENT
  ASSIGNMENT_NEW
  ASSIGNMENT_DUE
  ASSIGNMENT_OVERDUE
  EVENT_SOON
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

/// A place in Teams the portal may post to.
///
/// Two transports, and the difference is administrative rather than technical:
///
///   "webhook" — an Incoming Webhook / Power Automate Workflows URL that a
///               channel owner creates from inside Teams in about a minute. No
///               Azure tenant admin is involved, which is the whole reason it
///               is the default. Posts to a channel; cannot open a private
///               chat with one person.
///   "graph"   — Microsoft Graph, app-only. This is the one that can ping an
///               individual, and it needs a tenant admin to register an app
///               and consent to TeamsActivity.Send. Configured by environment
///               variable, not here, because it is a credential for the whole
///               deployment rather than for one channel.
///
/// `webhookUrl` is a bearer credential: anyone holding it can post into the
/// channel as the portal. It is encrypted at rest with the same AES-256-GCM
/// helper that covers phone numbers, and it is never sent back to a browser —
/// the admin screen shows the host and the last four characters only.
model TeamsTarget {
  id    String @id @default(cuid())
  label String

  /// "webhook" today. Left as a column so a second transport does not need a
  /// migration to become expressible.
  transport String @default("webhook") @db.VarChar(16)

  /// AES-256-GCM ciphertext. See src/lib/crypto.ts.
  webhookUrl String @db.Text
  /// Host of the URL, in the clear, so the admin list can say where posts go
  /// without the ciphertext ever being decrypted for a page render.
  urlHost    String @default("") @db.VarChar(190)
  /// Last four characters of the URL, for telling two webhooks apart.
  urlHint    String @default("") @db.VarChar(8)

  /// Null means the all-staff channel. Otherwise the department this posts for.
  departmentId String?
  isActive     Boolean @default(true)

  createdById String
  sendCount   Int       @default(0)
  lastOkAt    DateTime?
  lastErrorAt DateTime?
  lastError   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department   Department?       @relation(fields: [departmentId], references: [id])
  rules        NotificationRule[]
  jobs         NotificationJob[]

  @@index([departmentId])
  @@index([isActive])
  @@map("teams_targets")
}

/// Which Teams account a portal account belongs to.
///
/// Needed for the two things a channel post cannot do on its own: @mentioning
/// the right person inside a card, and sending that person a personal activity
/// notification. The portal already knows a school email; Teams keys on the
/// same UPN in this tenant, so the link is usually a copy of `users.email` and
/// the row exists mainly so that the exceptions are recordable.
model TeamsIdentity {
  id     String @id @default(cuid())
  userId String @unique

  /// User principal name — nearly always the school address.
  upn String @db.VarChar(190)
  /// Entra object id (a GUID). Graph can resolve a UPN, so this is optional,
  /// but a stored id is one lookup less and survives a rename.
  aadObjectId String? @db.VarChar(64)
  /// What to write in an @mention. Falls back to the portal name.
  displayName String? @db.VarChar(190)

  /// Set the first time Graph confirmed this person exists in the tenant.
  verifiedAt DateTime?
  /// Off means "never ping this person directly", whatever a rule says.
  optedOut   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([upn])
  @@map("teams_identities")
}

/// One switch: "when X happens in this department, post to Teams".
///
/// Rules are per department so a head can turn their own team's reminders on
/// without speaking for anybody else's, and a row with a null `departmentId`
/// is the portal-wide default that applies where no department row exists.
///
/// The unique index below is honest about only half the job: MySQL counts every
/// NULL as distinct, so it enforces one rule per (kind, department) for a real
/// department and nothing at all for the portal-wide row. Writes go through
/// `updateMany` for that reason — see saveNotificationRule().
model NotificationRule {
  id           String           @id @default(cuid())
  kind         NotificationKind
  departmentId String?

  enabled Boolean @default(false)

  /// ASSIGNMENT_DUE only: how many hours ahead of the deadline to warn.
  leadHours Int @default(24)
  /// Skip anything below this priority. MEDIUM by default for due reminders.
  minPriority Priority @default(LOW)
  /// Also send the assignees a personal Teams notification, not just a channel
  /// post. Requires Graph to be configured; ignored otherwise.
  pingPeople Boolean @default(false)

  /// Which channel to post in. Null resolves to the department's target, then
  /// to the all-staff one.
  targetId String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id])
  target     TeamsTarget? @relation(fields: [targetId], references: [id])

  @@unique([kind, departmentId])
  @@index([enabled])
  @@index([targetId])
  @@index([departmentId])
  @@map("notification_rules")
}

/// One message the portal wants delivered, and what happened to it.
///
/// Sending is queued rather than done inline. A Server Action that posts to
/// Teams while the person waits ties the success of their click to a third
/// party being up: Teams times out, the action throws, and the announcement
/// they wrote is lost along with the delivery. So the write commits, a row
/// lands here, and the dispatcher — /api/teams/dispatch, called on a schedule —
/// does the talking. A failure is then a row with an error on it that an admin
/// can read and retry, instead of a stack trace nobody saw.
///
/// `dedupeKey` is what stops a reminder being sent twice. "This assignment, this
/// rule, this day" hashes to one key, and the unique index makes the second
/// attempt a no-op at the database rather than a judgement call in code that
/// two overlapping dispatch runs could both get wrong.
model NotificationJob {
  id     String             @id @default(cuid())
  kind   NotificationKind
  status NotificationStatus @default(QUEUED)

  title String
  body  String  @db.Text
  /// Deep link back into the portal: the task, the announcement, the run sheet.
  url   String? @db.Text

  priority     Priority @default(MEDIUM)
  departmentId String?

  /// Where it goes. A channel post has `targetId`; a personal Teams ping has
  /// `recipientUserId`. Exactly one is set.
  targetId        String?
  recipientUserId String?

  /// Portal accounts to @mention inside a channel post, as a JSON array of ids.
  mentionUserIds Json?

  /// What in the portal caused this, for the log and for the deep link.
  sourceType String? @db.VarChar(32)
  sourceId   String?

  /// Null for anything the portal generated on a schedule.
  createdById String?
  /// Unique per logical message. See the note above.
  dedupeKey   String? @unique @db.VarChar(190)

  attempts  Int       @default(0)
  /// Not before this instant: the backoff between retries, and how "send at
  /// 07:00" is expressed for a reminder queued the night before.
  notBefore DateTime  @default(now())
  sentAt    DateTime?
  lastError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id])
  target     TeamsTarget? @relation(fields: [targetId], references: [id])
  recipient  User?        @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  createdBy  User?        @relation("NotificationCreatedBy", fields: [createdById], references: [id])

  @@index([status, notBefore])
  @@index([departmentId])
  @@index([recipientUserId])
  @@index([targetId])
  @@index([createdById])
  @@index([createdAt])
  @@map("notification_jobs")
}

// ---------------------------------------------------------------------------
// Page access — what each tier may do with each page of the portal
// ---------------------------------------------------------------------------

/// How far into a page a tier is allowed to go.
///
/// The four levels are cumulative and deliberately coarse. A finer grid would
/// be a second permission system running alongside `policy.ts`, and two systems
/// that both decide the same question is how a portal ends up letting somebody
/// into the audit log by accident.
enum PageAccessLevel {
  /// Gone. Not in the navigation, and the URL redirects.
  NONE
  /// Opens, reads, changes nothing.
  READ
  /// Reads, comments on threads, and answers forms. Still changes nothing else.
  COMMENT
  /// Whatever the tier's role already allows on that page.
  EDIT
}

/// One cell of the page-by-tier grid the owner edits.
///
/// Absent rows are not "no access" — they mean nobody has touched that cell, so
/// the built-in default in `src/lib/pages.ts` stands. That is what keeps a fresh
/// database and a five-year-old one behaving identically, and it is why the
/// table is written to only when somebody actually changes something.
///
/// This narrows `policy.ts`; it never widens it. A tier granted EDIT here can
/// still only do what its role allows, so switching Announcements to EDIT for
/// members does not turn members into broadcasters.
model PageAccess {
  /// A key from PORTAL_PAGES — "announcements", "audit", "files".
  page  String          @db.VarChar(48)
  tier  Tier
  level PageAccessLevel

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([page, tier])
  @@map("page_access")
}

// ---------------------------------------------------------------------------
// Passkeys, account recovery, in-portal notices (people workstream)
// ---------------------------------------------------------------------------

/// A WebAuthn credential. Only the public key is stored.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique @db.VarChar(512)
  publicKey    Bytes     @db.Blob
  counter      Int       @default(0)
  transports   String?   @db.VarChar(191)
  deviceType   String?   @db.VarChar(32)
  backedUp     Boolean   @default(false)
  label        String    @default("Passkey") @db.VarChar(80)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("passkeys")
}

enum RecoveryKind {
  USERNAME
  PASSWORD
  EMAIL
  OTHER
}

enum RecoveryStatus {
  PENDING
  APPROVED
  DENIED
}

/// "I forgot my username / password / email" from the public form. An admin
/// or owner approves it (which issues a reset link) or denies it.
model RecoveryRequest {
  id            String         @id @default(cuid())
  kind          RecoveryKind   @default(PASSWORD)
  contact       String         @db.VarChar(191)
  name          String?        @db.VarChar(120)
  message       String?        @db.Text
  matchedUserId String?
  status        RecoveryStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  resolution    String?        @db.Text
  resetId       String?
  ip            String?        @db.VarChar(64)
  createdAt     DateTime       @default(now())

  @@index([status])
  @@index([matchedUserId])
  @@map("recovery_requests")
}

/// A plain in-portal notice for one person (no Teams involved).
model PortalNotice {
  id        String    @id @default(cuid())
  userId    String
  title     String    @db.VarChar(191)
  body      String?   @db.Text
  href      String?   @db.VarChar(255)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("portal_notices")
}

/// An uploaded profile picture. Kept out of `users` so the session lookup,
/// which loads the whole user row, never drags image bytes along.
model AvatarImage {
  userId    String   @id
  mime      String   @db.VarChar(32)
  bytes     Bytes    @db.MediumBlob
  updatedAt DateTime @updatedAt

  @@map("avatar_images")
}

/// A staff calendar entry: meetings, deadlines, rehearsals. Heads and admins
/// add them; everyone sees them. A null department means all staff.
model CalendarEvent {
  id           String    @id @default(cuid())
  title        String    @db.VarChar(191)
  notes        String?   @db.Text
  location     String?   @db.VarChar(191)
  startsAt     DateTime
  endsAt       DateTime?
  allDay       Boolean   @default(false)
  departmentId String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([startsAt])
  @@map("calendar_events")
}
